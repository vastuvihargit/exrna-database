# dependencies
node_modules/
.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# testing
/coverage
/.vitest

# secrets — every env file except the example
.env
.env.*
!.env.example

# Cloudflare Worker secrets for local dev — same contents as the production secret store
.dev.vars
.dev.vars.*
!.dev.vars.example

# Cloudflare build output and local state (.wrangler holds the local D1 SQLite file,
# which is application data and must never enter version control)
/.open-next/
/.wrangler/
worker-configuration.d.ts

# curl cookie jars — these hold live bd_session tokens from local smoke runs
cookies.txt
*-cookies.txt
.*-cookies.txt

# local file storage — application data must never enter version control
/.data/
/data/
*.storage-key

# logs
*.log
npm-debug.log*
logs/
.dev-out.log
.dev-err.log

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# misc
*.pem
.tsbuildinfo
*.tsbuildinfo

# Mongo → D1 migration reports (source ids and failure payloads)
/migration-reports/
