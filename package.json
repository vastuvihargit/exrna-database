{
  "name": "biotech-research-drive",
  "version": "0.1.0",
  "private": true,
  "description": "Secure company-internal Biotech Research Drive — MongoDB metadata + private local server storage",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.d1.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cf:build": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare build",
    "cf:preview": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare preview",
    "cf:deploy": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply biotech-drive-dev --env development --local",
    "db:migrate:staging": "wrangler d1 migrations apply biotech-drive-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply biotech-drive-production --env production --remote",
    "db:studio": "drizzle-kit studio",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "check:env": "tsx scripts/check-env.ts",
    "seed": "tsx scripts/seed.ts",
    "storage:init": "tsx scripts/init-storage.ts",
    "verify:storage": "tsx scripts/verify-storage-integrity.ts",
    "purge:trash": "tsx scripts/purge-trash.ts",
    "cleanup:uploads": "tsx scripts/cleanup-uploads.ts",
    "monitor": "tsx scripts/monitor.ts",
    "review:indexes": "tsx scripts/review-indexes.ts",
    "drive:drain": "tsx scripts/drain-drive-transfers.ts",
    "drive:check-approvals": "tsx scripts/check-approved-content.ts",
    "drive:sync": "tsx scripts/sync-drive-changes.ts",
    "test:mongo": "vitest run",
    "acl:validate": "tsx scripts/validate-acl-uniqueness.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.10.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.4",
    "officeparser": "^7.5.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.83.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.7",
    "jsdom": "^26.0.0",
    "miniflare": "^5.20260730.0-alpha",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.118.0"
  }
}
