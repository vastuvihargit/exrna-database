# ─────────────────────────────────────────────────────────────────────────────
# Biotech Research Drive — environment configuration
# Copy to .env (development) / .env.staging / .env.production and fill in.
# NEVER commit a filled-in copy. .env* is git-ignored except this example.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Biotech Research Drive
PORT=3000
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# A replica set is required for multi-document transactions (single-node rs0 is fine).
MONGODB_URI=mongodb://mongodb:27017/biotech_drive?replicaSet=rs0
MONGODB_DATABASE=biotech_drive

# ── Secrets (min 32 characters each) ─────────────────────────────────────────
AUTH_SECRET=
SESSION_SECRET=

# ── Company-email-only access ────────────────────────────────────────────────
# Comma-separated list of allowed sign-in domains. Anything else is rejected.
COMPANY_EMAIL_DOMAINS=company.com
# false = an admin must create the account before the employee can sign in.
ALLOW_AUTO_PROVISIONING=false

# ── Private server file storage (NEVER inside public/ and NEVER browser storage) ──
# Absolute paths in Docker; relative paths are resolved against the project root in dev.
LOCAL_STORAGE_ROOT=/data/storage
TEMP_UPLOAD_ROOT=/data/temp
QUARANTINE_ROOT=/data/quarantine
PREVIEW_ROOT=/data/previews
EXPORT_ROOT=/data/exports

# ── Limits & quotas ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2048
DEFAULT_USER_STORAGE_QUOTA_GB=20
DEFAULT_DEPARTMENT_STORAGE_QUOTA_GB=500
# Uploads are refused when free disk space would drop below this floor.
MIN_FREE_DISK_GB=10
UPLOAD_CHUNK_SIZE_MB=8

# ── Retention ────────────────────────────────────────────────────────────────
TRASH_RETENTION_DAYS=30
INCOMPLETE_UPLOAD_RETENTION_HOURS=24
EXPORT_RETENTION_HOURS=24

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# ── Developer tooling (the 🛠 DEV switcher) ──────────────────────────────────
# A floating panel that switches the browser between seeded development accounts by
# issuing a REAL session — no password required. Invaluable for testing a permission
# system, and completely unacceptable outside development.
#
# On by default when NODE_ENV is not production. Set to false for a staging box that
# should behave like production without being a production build.
#
# It CANNOT be enabled in production: /api/dev/* returns 404 there, the panel is never
# rendered, and the process REFUSES TO BOOT if a production configuration sets this to
# true — so a stray value here fails loudly at deploy time rather than quietly shipping
# an anonymous session-minting endpoint.
ENABLE_DEV_SWITCHER=true

# ── Malware scanning (Phase 11) ──────────────────────────────────────────────
# Disabled by default so a deployment without antivirus is a *stated* risk, reported on
# the admin System page, rather than a silent one. The prod compose file runs a ClamAV
# container on the internal network.
MALWARE_SCAN_ENABLED=false
# Explicit choice of scanner; wins over MALWARE_SCAN_ENABLED when set.
#   disabled | clamav (Node only: raw TCP to clamd) | http (vendor-neutral; what a Worker uses)
# For http: an https endpoint in production and a shared secret of 16+ characters. The wire
# contract is in src/server/security/malware-scanner.ts and docs/cloudflare-migration/24-malware-scanning.md.
MALWARE_SCAN_MODE=
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_SECRET=
MALWARE_SCAN_TIMEOUT_MS=120000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
# What an *inconclusive* scan means. Forced to true in production when scanning is
# enabled: a scanner that is down means "unknown", and treating unknown as clean is how
# an antivirus deployment quietly stops protecting anything. Set explicitly to false
# only if refusing uploads during a scanner outage is worse for you than storing
# unscanned files — and know that you have chosen that.
MALWARE_SCAN_FAIL_CLOSED=true

# ── Backup ───────────────────────────────────────────────────────────────────
BACKUP_ROOT=/data/backups
BACKUP_RETENTION_DAYS=30
# Required by the backup container. Without it, restic cannot encrypt the repository and
# the backup job refuses to start. Store it somewhere you can reach when the server is
# gone — a backup password that only exists on the machine being backed up is not one.
BACKUP_ENCRYPTION_PASSWORD=
# The rule the entire backup design exists for: the only copy must never live on the
# same disk as the application. A restic repository URL — sftp:user@host:/path,
# s3:s3.amazonaws.com/bucket, rclone:remote:path.
BACKUP_OFFSITE_TARGET=
# Run one backup immediately when the backup container starts, so a new deployment is
# protected within minutes rather than at 02:15 tomorrow.
BACKUP_RUN_ON_START=false
# How many restored objects the weekly restore drill re-hashes against their recorded
# checksums.
RESTORE_DRILL_SAMPLE=25

# ── Monitoring and alerting (Phase 11) ───────────────────────────────────────
# Disk, backup, restore-drill, scanner and database alerts are always written to the
# structured log. If this is set they are also POSTed here (Slack/Teams/PagerDuty-style
# JSON with both a `text` field and structured fields). Leave blank for log-only
# alerting — which degrades the channel, not the checking.
ALERT_WEBHOOK_URL=

# ── Cloudflare Access (optional on Node) ─────────────────────────────────────
# Set BOTH to put the application behind Cloudflare Access: Access becomes the only sign-in
# method and every request's Access assertion must match its session. Set together or not at
# all — loadEnv refuses half. Leave empty for local development.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Google Workspace OAuth + Drive migration (Phase 2 / Phase 10) ────────────
# AUTH_PROVIDER=google_oauth makes Google Workspace sign-in the only front door: CF_ACCESS_*
# must be unset, password sign-in is closed, unknown users are refused (no auto-provisioning),
# and GOOGLE_REDIRECT_URI defaults to ${APP_URL}/api/auth/google/callback.
# AUTH_PROVIDER=google_oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Separate callback for the Drive migration grant. It carries a far broader scope than
# sign-in (read access to an entire Drive), so it gets its own redirect and cannot be
# obtained by replaying the login flow. Leave blank to disable migrations entirely.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/admin/migrations/callback

# ── Google Shared Drive as the storage backend ───────────────────────────────
# NOT the same feature as GOOGLE_DRIVE_REDIRECT_URI above. That one imports content
# *from* a Drive into this platform, read-only, once. This one makes a company Shared
# Drive the place file bytes actually live. See docs/storage-migration/.
#
# Everything here is optional and unread while the flag is false — which is the default,
# and the correct setting until the migration phases are complete.
GOOGLE_DRIVE_STORAGE_ENABLED=false

# Where NEW uploads go: local | google_drive. Existing files always read from whichever
# provider their own record names, so flipping this never strands anything. Setting it to
# google_drive while GOOGLE_DRIVE_STORAGE_ENABLED is false refuses to boot.
DEFAULT_STORAGE_PROVIDER=local

# Where bytes are held while they are still untrusted: local | google_drive.
#
# NOT a duplicate of DEFAULT_STORAGE_PROVIDER, and the difference is the rollback plan.
#
#   local (default) — stream to quarantine, scan, move into originals, record, THEN hand off
#     to Drive. The local copy is retained for LOCAL_COPY_RETENTION_DAYS and is what a
#     rollback restores from. A Drive outage costs latency, not availability.
#
#   google_drive — stream straight into a Drive resumable upload and promote by re-parenting.
#     Nothing is written to a disk, so there is NO local copy and NO fallback for anything
#     uploaded this way. This is the only value a Cloudflare Worker can run with, because
#     workerd has no persistent filesystem.
#
# Both settings must agree: staging in Drive while recording content as local would produce
# versions whose bytes are in Drive and whose record points at a disk. env.ts refuses it.
UPLOAD_STAGING=local

# The company Shared Drive. NOT an employee's My Drive: a Shared Drive owns its own
# content, so files survive the employee leaving, and a service account has no personal
# storage quota to write against. Copy the id from the Drive URL:
#   https://drive.google.com/drive/folders/<GOOGLE_SHARED_DRIVE_ID>
GOOGLE_SHARED_DRIVE_ID=
# Optional folder inside that drive to scope everything under. Blank = the drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_WORKSPACE_DOMAIN=company.com

# Service account, added as a **Content Manager member of the Shared Drive**.
# Not domain-wide delegation: that would let this one key impersonate any employee in the
# domain, turning a leaked environment variable into a full-domain compromise. Shared
# Drives accept service accounts as members directly, and nothing here needs impersonation
# — MongoDB remains the authoritative permission model.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# Development only: the PEM inline, newlines escaped as \n.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Production: a path to a mounted Docker/Kubernetes secret. Takes precedence over the
# inline value above, so a stale inline copy can never win over the mounted one.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY_FILE=

# Above this size a new upload is queued for Drive instead of transferred while the employee
# waits. A latency control, not a correctness one: the file is complete and readable either
# way the moment the upload finishes — only where its bytes live differs, and both are
# served. The queue is drained by `npm run drive:drain` (run it from cron every few minutes)
# and its depth is shown on the admin System page.
UPLOAD_DRIVE_SYNC_THRESHOLD_MB=100

# Whether employees may open a Google Doc, Sheet or Slide in Google's own editor.
#
# Off by default, and the default is deliberate. Every Drive operation here runs as the
# service account; your employees' own Google accounts are not necessarily members of the
# Shared Drive at all. Turning this on when they are not sends them to a Google
# permission-denied page and makes this application look broken over something it cannot fix.
#
# Turn it on only when the Shared Drive is genuinely shared with the staff who use this
# application — and note what it means when you do: what someone may do *inside* the Google
# editor is governed by Drive's own sharing, not by this application's permissions.
#
# Uploaded files (PDFs, images, datasets, Office documents) are unaffected either way: they
# are previewed and downloaded through this application and never need Drive access.
GOOGLE_DRIVE_NATIVE_EDITOR_ENABLED=false

# How often `npm run drive:sync` is expected to run, in minutes.
#
# This does NOT schedule anything — put the job in cron yourself. It is what the admin System
# page compares against to decide whether synchronization has stalled, and a deployment that
# sets this without scheduling the job will (correctly) show a warning: believing you are
# synchronizing when you are not is the state worth complaining about, because every symptom
# of it looks like success.
DRIVE_SYNC_INTERVAL_MINUTES=15

# Transfer tuning. Concurrency is bounded so a migration can never exhaust the Drive API
# quota that employees' interactive uploads and downloads share.
GOOGLE_DRIVE_UPLOAD_CHUNK_MB=16
GOOGLE_DRIVE_MAX_CONCURRENT_TRANSFERS=4
GOOGLE_DRIVE_REQUEST_TIMEOUT_MS=120000

# ── Local copy retention after migration ─────────────────────────────────────
# Retaining the local copy is the entire rollback mechanism: reverting a migrated file to
# local storage is a single database field change with no data movement, and that only
# works while the bytes are still on disk. Deletion is a separate, explicit admin action.
LOCAL_COPY_RETENTION_DAYS=30
DELETE_LOCAL_AFTER_MIGRATION=false

# ── Microsoft Entra ID OAuth (optional, Phase 2) ─────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft

# ── Email (notifications, invitations, password reset) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Mongo container bootstrap (docker compose only) ──────────────────────────
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
